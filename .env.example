# ==============================================================================
# ApexGuard Environment Configuration
# ==============================================================================
# In offline mode (when credentials are omitted), ApexGuard seamlessly uses local
# deterministic rulebook evaluation and formal FIA judicial document templates.
#
# The moment you add credentials below, ApexGuard automatically connects to
# Strands Decider 2B and Amazon Bedrock with zero code changes required.
# ==============================================================================

# --- Layer 2: Strands Decider 2B ---
# STRANDS_API_KEY=your_strands_api_key_here
# STRANDS_ENDPOINT=https://api.strands.ai/v1/decider-2b

# --- Layer 3: Amazon Bedrock ---
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# (Alternative Amazon & Bedrock Models: amazon.nova-micro-v1:0, amazon.titan-text-express-v1, anthropic.claude-3-haiku-20240307-v1:0)
